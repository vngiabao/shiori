  "grammar": [
    {
      "id": "n5-u04-g-aru-iru",
      "title": "あります and います",
      "explanation": "あります for things and plants, います for people and animals. Where something is: X は Y の 上/下/中/となり/前 に あります/います. Asking: X はどこですか or X はどこにありますか.",
      "example": "猫はつくえの下にいます。",
      "translation": "The cat is under the desk."
    },
    {
      "id": "n5-u04-g-mashita",
      "title": "Past: ました and でした",
      "explanation": "ます becomes ました (見ました, 行きました); ません becomes ませんでした. です becomes でした. Time words like 昨日 usually come first.",
      "example": "昨日、カフェに行きました。",
      "translation": "Yesterday I went to the café."
    }
  ],
