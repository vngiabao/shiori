  "grammar": [
    {
      "id": "n5-u12-g-n-desu",
      "title": "んです: explaining",
      "explanation": "Plain form + んです explains or asks for an explanation: 頭が痛いんです, 'it's that my head hurts'. Nouns and な adjectives take な: 学生なんです, 暇なんです. どうしたんですか asks what's wrong. Use it when the situation calls for a reason; overusing it sounds pushy.",
      "example": "頭が痛いんです。熱もあるんです。",
      "translation": "My head hurts. I've got a fever too."
    },
    {
      "id": "n5-u12-g-advice",
      "title": "ほうがいい, ので and なければいけない",
      "explanation": "た-form + ほうがいいです: you'd better (advice). Reason + ので: because (softer and more polite than から). ない-form minus い + ければいけません: must (勉強しなければいけません).",
      "example": "薬を飲んだほうがいいですよ。",
      "translation": "You should take some medicine."
    }
  ],
