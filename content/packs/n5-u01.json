  "grammar": [
    {
      "id": "n5-u01-g-desu-ka",
      "title": "X は Y です / ですか",
      "explanation": "X は Y です: 'X is Y' (は is read wa). Add か to ask: X は Y ですか, 'Is X Y?'. Answer はい、そうです (yes, that's right) or いいえ、… です with the correct information.",
      "example": "ハナさんはアメリカ人ですか。",
      "translation": "Is Hana American?"
    },
    {
      "id": "n5-u01-g-nan-ji",
      "title": "何時ですか: telling the time",
      "explanation": "Number + 時 (ji) is the hour; add 半 (han) for half past. 四時 is よじ and 九時 is くじ: learn those two as exceptions. 何 is read なん before で, じ and さい, and なに before を.",
      "example": "今、三時半です。",
      "translation": "It's half past three now."
    }
  ],
