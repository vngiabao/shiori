  "grammar": [
    {
      "id": "n5-u05-g-adjectives",
      "title": "い adjectives and な adjectives",
      "explanation": "い adjectives end in い: 寒いです, not 寒いだ. Negative: 寒くないです. な adjectives take な before a noun (静かな町) and じゃないです for the negative (静かじゃないです). きれい looks like an い adjective but is a な adjective.",
      "example": "静かなお寺です。",
      "translation": "It's a quiet temple."
    },
    {
      "id": "n5-u05-g-past-adj",
      "title": "Past adjectives",
      "explanation": "い adjectives: drop い, add かったです (楽しい → 楽しかったです). Never 楽しいでした. な adjectives: でした (静かでした). いい is irregular: よかったです.",
      "example": "旅行は楽しかったです。",
      "translation": "The trip was fun."
    }
  ],
