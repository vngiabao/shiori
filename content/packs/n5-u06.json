  "grammar": [
    {
      "id": "n5-u06-g-te-kudasai",
      "title": "て-form + ください",
      "explanation": "The て-form joins verbs and makes requests. Verb て + ください = 'please do'. Common て-forms: 待つ→待って, 書く→書いて, 座る→座って, 教える→教えて, 来る→来て, する→して.",
      "example": "ここに名前を書いてください。",
      "translation": "Please write your name here."
    },
    {
      "id": "n5-u06-g-te-mo-ii",
      "title": "てもいいですか and てはいけません",
      "explanation": "て + もいいですか asks permission: 撮ってもいいですか, 'may I take…?'. Yes: はい、どうぞ. A gentle no: すみません、ちょっと…. A rule: て + はいけません, 'you must not'.",
      "example": "写真を撮ってもいいですか。",
      "translation": "May I take a photo?"
    }
  ],
