  "grammar": [
    {
      "id": "n5-u02-g-kosoa",
      "title": "これ・それ・あれ and この・その・あの",
      "explanation": "こ = near me, そ = near you, あ = away from both of us. これ/それ/あれ stand alone ('this one'); この/その/あの need a noun after them ('this book'). ど asks which: どれ, どの.",
      "example": "あの雑誌はいくらですか。",
      "translation": "How much is that magazine over there?"
    },
    {
      "id": "n5-u02-g-prices",
      "title": "Prices: 百 and 千",
      "explanation": "百 = 100, 千 = 1,000, then 円. Some combinations change sound: 三百 さんびゃく, 六百 ろっぴゃく, 八百 はっぴゃく, 三千 さんぜん, 八千 はっせん. Ask with いくらですか and buy with … をください.",
      "example": "辞書は二千円です。",
      "translation": "The dictionary is 2,000 yen."
    }
  ],
