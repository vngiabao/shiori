        {
          "speaker": "You",
          "line": "はい。{父|ちち}と{母|はは}と{姉|あね}です。",
          "romaji": "Hai. Chichi to haha to ane desu.",
          "meaning": "Yes. My father, my mother and my older sister."
        },
        {
          "speaker": "Yui",
          "line": "お{姉|ねえ}さんは{髪|かみ}が{長|なが}いですね。",
          "romaji": "Onēsan wa kami ga nagai desu ne.",
          "meaning": "Your sister has long hair."
        },
        {
          "speaker": "You",
          "line": "はい。{姉|あね}は{東京|とうきょう}に{住|す}んでいます。{会社|かいしゃ}で{働|はたら}いています。",
          "romaji": "Hai. Ane wa Tōkyō ni sunde imasu. Kaisha de hataraite imasu.",
          "meaning": "Yes. She lives in Tokyo. She works at a company."
        },
        {
          "speaker": "Yui",
          "line": "そうですか。ご{両親|りょうしん}は？",
          "romaji": "Sō desu ka. Goryōshin wa?",
          "meaning": "I see. And your parents?"
        },
        {
