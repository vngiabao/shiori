  "grammar": [
    {
      "id": "n5-u07-g-teiru",
      "title": "ています: ongoing states",
      "explanation": "て-form + います describes an ongoing action or a lasting state: 住んでいます (lives), 働いています (works), 結婚しています (is married). Place of living takes に; place of work takes で.",
      "example": "姉は東京に住んでいます。",
      "translation": "My older sister lives in Tokyo."
    },
    {
      "id": "n5-u07-g-uchi-soto",
      "title": "My family, your family",
      "explanation": "When you talk about your family to people outside it, use the plain words (父, 母, 兄, 姉); for someone else's family use the polite ones (お父さん, お母さん, お兄さん, お姉さん, ご家族). This is the safe beginner convention for polite conversation. Inside the family, and in casual talk, people often say お母さん for their own mother too.",
      "example": "お母さんはお元気ですか。",
      "translation": "Is your mother well?"
    }
  ],
