  "grammar": [
    {
      "id": "n5-u08-g-plain",
      "title": "Plain forms: how friends talk",
      "explanation": "With friends and family, Japanese switches to the plain form of the verb: 行きます → 行く, 行きません → 行かない, します → する, 来ます → 来る. Nouns and な adjectives take だ (or nothing) instead of です: 暇だよ, 雨だよ. A question is just rising intonation: 行く？ An invitation: 行かない？ (= 行きませんか). Much anime dialogue between friends is plain; use です/ます with people you don't know well.",
      "example": "一緒に行かない？",
      "translation": "Want to come along?"
    },
    {
      "id": "n5-u08-g-omou",
      "title": "と思う and ないで",
      "explanation": "Plain form + と思う/と思います = 'I think that…': 雨が降ると思う. Plain negative + で (ください) = 'please don't': 心配しないでください.",
      "example": "明日は雨が降ると思います。",
      "translation": "I think it will rain tomorrow."
    }
  ],
  "kanji": [],
  "dialogues": [
    {
      "id": "n5-u08-d",
      "title": "A barbecue invitation",
      "scene": "Hana calls out to you in the corridor, as friends do.",
      "lines": [
        {
          "speaker": "Hana",
          "line": "{明日|あした}、{暇|ひま}？",
          "romaji": "Ashita, hima?",
          "meaning": "Are you free tomorrow?"
        },
        {
          "speaker": "You",
          "line": "うん、{暇|ひま}だよ。",
          "romaji": "Un, hima da yo.",
          "meaning": "Yeah, I'm free."
        },
        {
          "speaker": "Hana",
          "line": "レンさんとバーベキューをする。{一緒|いっしょ}に{行|い}かない？",
          "romaji": "Ren-san to bābekyū o suru. Issho ni ikanai?",
          "meaning": "I'm having a barbecue with Ren. Want to come?"
        },
        {
          "speaker": "You",
          "line": "いいね。でも、{明日|あした}は{雨|あめ}が{降|ふ}ると{思|おも}う。",
          "romaji": "Ii ne. Demo, ashita wa ame ga furu to omou.",
          "meaning": "Sounds good. But I think it'll rain tomorrow."
        },
        {
          "speaker": "Hana",
          "line": "{大丈夫|だいじょうぶ}。レンさんのカフェでする。",
          "romaji": "Daijōbu. Ren-san no kafe de suru.",
          "meaning": "It's fine. We're doing it at Ren's café."
        },
        {
          "speaker": "You",
          "line": "じゃあ、{何|なに}か{持|も}って{行|い}く？",
          "romaji": "Jaa, nanika motte iku?",
          "meaning": "Then do I need to bring anything?"
        },
        {
          "speaker": "Hana",
          "line": "ううん、{心配|しんぱい}しないで。",
          "romaji": "Uun, shinpai shinaide.",
          "meaning": "Nah, don't worry about it."
        }
      ],
      "lesson": "n5-u08-lesson"
    }
  ],
