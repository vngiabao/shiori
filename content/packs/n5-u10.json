  "grammar": [
    {
      "id": "n5-u10-g-compare",
      "title": "より and のほうが",
      "explanation": "A は B より + adjective: 'A is more … than B'. A のほうが + adjective: 'A is the more … one'. Of three or more: X が一番 + adjective. 飛行機は新幹線より速いです = 飛行機のほうが速いです.",
      "example": "冬は沖縄のほうが暖かいです。",
      "translation": "In winter, Okinawa is warmer."
    },
    {
      "id": "n5-u10-g-tsumori",
      "title": "つもり, で (means) and かかります",
      "explanation": "Dictionary form + つもりです: what you intend to do. Means of travel + で: 飛行機で行きます. From A to B: A から B まで. How long: 時間がかかります; 何時間かかりますか asks how many hours.",
      "example": "東京から京都まで新幹線で二時間かかります。",
      "translation": "It takes two hours from Tokyo to Kyoto by bullet train."
    }
  ],
