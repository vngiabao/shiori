  "dialogues": [
    {
      "id": "n5-u11-d",
      "title": "The first class of the year",
      "scene": "Satō-sensei asks about your winter break.",
      "lines": [
        {
          "speaker": "Satō",
          "line": "{冬休|ふゆやす}みはどうでしたか。",
          "romaji": "Fuyuyasumi wa dō deshita ka.",
          "meaning": "How was your winter break?"
        },
        {
          "speaker": "You",
          "line": "{北海道|ほっかいどう}で{雪|ゆき}を{見|み}たり、{温泉|おんせん}に{入|はい}ったりしました。",
          "romaji": "Hokkaidō de yuki o mitari, onsen ni haittari shimashita.",
          "meaning": "In Hokkaido I saw the snow, went to a hot spring, that kind of thing."
        },
        {
          "speaker": "Satō",
          "line": "いいですね。{私|わたし}は{北海道|ほっかいどう}に{行|い}ったことがありません。",
          "romaji": "Ii desu ne. Watashi wa Hokkaidō ni itta koto ga arimasen.",
          "meaning": "How lovely. I've never been to Hokkaido."
        },
        {
          "speaker": "You",
          "line": "{先生|せんせい}は{冬休|ふゆやす}みに{何|なに}をしましたか。",
          "romaji": "Sensei wa fuyuyasumi ni nani o shimashita ka.",
          "meaning": "What did you do over the break, Sensei?"
        },
        {
          "speaker": "Satō",
          "line": "{富士山|ふじさん}を{見|み}に{行|い}きました。",
          "romaji": "Fujisan o mi ni ikimashita.",
          "meaning": "I went to see Mt Fuji."
        },
        {
          "speaker": "You",
          "line": "いいですね。{私|わたし}は{富士山|ふじさん}に{登|のぼ}りたいです。",
          "romaji": "Ii desu ne. Watashi wa Fujisan ni noboritai desu.",
          "meaning": "That sounds great. I'd like to climb Mt Fuji."
        },
        {
          "speaker": "Satō",
          "line": "{夏|なつ}がいいですよ。",
          "romaji": "Natsu ga ii desu yo.",
          "meaning": "Summer is the time for that."
        }
      ],
      "lesson": "n5-u11-lesson"
    }
