  "grammar": [
    {
      "id": "n5-u11-g-tai",
      "title": "たい: wanting to do",
      "explanation": "Verb stem (the ます form without ます) + たいです: 行きます → 行きたいです. It behaves like an い adjective: 行きたくないです (don't want to). Use it about yourself; for others, Japanese avoids stating their wishes directly.",
      "example": "富士山に登りたいです。",
      "translation": "I want to climb Mt Fuji."
    },
    {
      "id": "n5-u11-g-tari-koto",
      "title": "たり〜たりする and ことがある",
      "explanation": "た-form + り, た-form + り + する lists examples of what you did: 雪を見たり、温泉に入ったりしました. た-form + ことがあります: you have done it (at least once); ことがありません: never.",
      "example": "北海道に行ったことがありません。",
      "translation": "I have never been to Hokkaido."
    }
  ],
