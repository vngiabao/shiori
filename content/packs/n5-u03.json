  "grammar": [
    {
      "id": "n5-u03-g-particles",
      "title": "に, で and を with ます verbs",
      "explanation": "に marks a point in time (三時に) or where you go (カフェに行きます). で marks where an action happens (家で勉強します). を marks what the action is done to (映画を見ます). Days of the week usually take に; 今日 and 明日 do not.",
      "example": "土曜日にカフェで映画を見ます。",
      "translation": "On Saturday I'll watch a film at the café."
    },
    {
      "id": "n5-u03-g-masenka",
      "title": "ませんか: inviting",
      "explanation": "Turn ます into ませんか to invite: 見ませんか, 'won't you watch…?'. It sounds softer than a plain question. Accept with いいですね; decline gently with ちょっと… (a little…).",
      "example": "一緒に映画を見ませんか。",
      "translation": "Would you like to watch a film together?"
    }
  ],
