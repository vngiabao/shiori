  "grammar": [
    {
      "id": "n5-u09-g-plain-past",
      "title": "Plain past: た",
      "explanation": "The plain past is the て-form with た instead of て, and だ instead of で: 食べて → 食べた, 行って → 行った, して → した, 寝て → 寝た, 読んで → 読んだ, 飲んで → 飲んだ. Polite equivalents: 食べました, 行きました. い adjectives: おいしかった.",
      "example": "週末、何した？",
      "translation": "What did you do at the weekend?"
    },
    {
      "id": "n5-u09-g-kara",
      "title": "から (because) and もう / まだ",
      "explanation": "Reason + から, result: 疲れたから、寝た ('I was tired, so I slept'). The reason comes first. もう + past = already; まだ = not yet, often answered alone: まだ.",
      "example": "宿題はもう終わった？",
      "translation": "Have you finished your homework yet?"
    }
  ],
  "dialogue": {
    "id": "n5-u09-d",
    "title": "Monday morning",
    "scene": "Hana asks about your weekend before class.",
