  "grammar": [
    {
      "id": "n5-u02-g-kosoa",
      "title": "これ・それ・あれ and この・その・あの",
      "explanation": "こ = near me, そ = near you, あ = away from both of us. これ/それ/あれ stand alone ('this one'); この/その/あの need a noun after them ('this book'). ど asks which: どれ, どの.",
      "example": "あの雑誌はいくらですか。",
      "translation": "How much is that magazine over there?"
    },
    {
      "id": "n5-u02-g-prices",
      "title": "Prices: 百 and 千",
      "explanation": "百 = 100, 千 = 1,000, then 円. Some combinations change sound: 三百 さんびゃく, 六百 ろっぴゃく, 八百 はっぴゃく, 三千 さんぜん, 八千 はっせん. Ask with いくらですか and buy with … をください.",
      "example": "辞書は二千円です。",
      "translation": "The dictionary is 2,000 yen."
    }
  ],
  "dialogue": {
    "id": "n5-u02-d",
    "title": "A magazine at Yui's",
    "scene": "You are in Yui's bookshop, looking at the shelves near the door.",
    "lines": [
      {
        "speaker": "You",
        "line": "すみません、あの{雑誌|ざっし}はいくらですか。",
        "romaji": "Sumimasen, ano zasshi wa ikura desu ka.",
        "meaning": "Excuse me, how much is that magazine over there?"
      },
      {
        "speaker": "Yui",
        "line": "あの{雑誌|ざっし}ですか。{五百円|ごひゃくえん}です。",
        "romaji": "Ano zasshi desu ka. Gohyaku-en desu.",
        "meaning": "That magazine? It's 500 yen."
      },
      {
        "speaker": "You",
        "line": "じゃあ、あの{雑誌|ざっし}をください。",
        "romaji": "Jaa, ano zasshi o kudasai.",
        "meaning": "Then I'll take that magazine, please."
      },
      {
        "speaker": "Yui",
        "line": "はい。この{辞書|じしょ}もどうですか。{二千円|にせんえん}です。",
        "romaji": "Hai. Kono jisho mo dō desu ka. Nisen-en desu.",
        "meaning": "Sure. How about this dictionary too? It's 2,000 yen."
      },
      {
        "speaker": "You",
        "line": "いいえ、{大丈夫|だいじょうぶ}です。",
        "romaji": "Iie, daijōbu desu.",
        "meaning": "No, thank you."
      },
      {
        "speaker": "Yui",
        "line": "ありがとうございます。",
        "romaji": "Arigatō gozaimasu.",
        "meaning": "Thank you."
      }
    ]
  },
