  "grammar": [
    {
      "id": "n5-u04-g-aru-iru",
      "title": "あります and います",
      "explanation": "あります for things and plants, います for people and animals. Where something is: X は Y の 上/下/中/となり/前 に あります/います. Asking: X はどこですか or X はどこにありますか.",
      "example": "猫はつくえの下にいます。",
      "translation": "The cat is under the desk."
    },
    {
      "id": "n5-u04-g-mashita",
      "title": "Past: ました and でした",
      "explanation": "ます becomes ました (見ました, 行きました); ません becomes ませんでした. です becomes でした. Time words like 昨日 usually come first.",
      "example": "昨日、カフェに行きました。",
      "translation": "Yesterday I went to the café."
    }
  ],
  "dialogue": {
    "id": "n5-u04-d",
    "title": "The missing key",
    "scene": "You're about to leave Ren's café when you can't find your key.",
    "lines": [
      {
        "speaker": "You",
        "line": "レンさん、すみません。かぎがありません。",
        "romaji": "Ren-san, sumimasen. Kagi ga arimasen.",
        "meaning": "Ren, sorry. I can't find my key."
      },
      {
        "speaker": "Ren",
        "line": "かぎですか。かばんの{中|なか}は？",
        "romaji": "Kagi desu ka. Kaban no naka wa?",
        "meaning": "Your key? Is it in your bag?"
      },
      {
        "speaker": "You",
        "line": "{中|なか}にはありません。",
        "romaji": "Naka ni wa arimasen.",
        "meaning": "It's not in there."
      },
      {
        "speaker": "Ren",
        "line": "あ、あのつくえの{上|うえ}にありますよ。",
        "romaji": "A, ano tsukue no ue ni arimasu yo.",
        "meaning": "Oh, it's on that desk over there."
      },
      {
        "speaker": "You",
        "line": "あ、ありました。ありがとうございます。",
        "romaji": "A, arimashita. Arigatō gozaimasu.",
        "meaning": "Oh, there it is. Thank you."
      },
      {
        "speaker": "Ren",
        "line": "つくえの{下|した}に{猫|ねこ}もいますよ。",
        "romaji": "Tsukue no shita ni neko mo imasu yo.",
        "meaning": "There's a cat under the desk, too."
      }
    ]
  },
